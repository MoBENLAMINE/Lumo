# Maintainer: Mohammed Benlamine <mohammedbenlamine61@gmail.com>
pkgname=lumo-git
pkgver=0.1.0
pkgrel=1
pkgdesc="A tiny friend at the top of your screen for your AI coding agents (KDE Plasma, Wayland)"
arch=('x86_64')
url="https://github.com/MoBENLAMINE/Lumo"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'layer-shell-qt' 'kglobalaccel' 'wl-clipboard' 'libpulse')
makedepends=('cmake' 'git' 'curl' 'qt6-shadertools')
optdepends=('claude-code: Claude chat and agent sessions'
            'ollama: chat with a local model')
provides=('lumo')
conflicts=('lumo')
source=("lumo::git+https://github.com/MoBENLAMINE/Lumo.git")
sha256sums=('SKIP')

pkgver() {
  cd lumo
  printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S lumo -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure -R "hub|vocabulary"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 lumo/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
